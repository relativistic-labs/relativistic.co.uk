---
// The background field, a murmuration: decorative, and an enhancement. Without JavaScript or WebGL2
// it isn't shown. It is a toggle button so the animation can be paused from a pointer or the keyboard
// (WCAG 2.2.2). Its name never changes; aria-pressed says whether it is paused, so it's announced once.
---

<button class="field" type="button" data-field aria-pressed="false" aria-label="Pause background animation">
  <canvas class="field__canvas" aria-hidden="true"></canvas>
</button>

<script>
  import { startField } from '../scripts/field/field';

  const root = document.querySelector<HTMLButtonElement>('[data-field]');
  if (root) {
    // After first paint, when the browser is idle. Nothing waits for the field.
    const start = () => void startField(root);
    requestAnimationFrame(() =>
      'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 300),
    );
  }
</script>
