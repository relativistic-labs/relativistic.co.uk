---
// The particle field: decorative, and an enhancement. Without JavaScript or WebGL2 it simply isn't drawn.
---

<div class="field" data-field>
  <canvas class="field__canvas" aria-hidden="true"></canvas>
  <div class="field__bar">
    <p class="field__scene" aria-hidden="true"><b data-scene-number>001</b> / <span data-scene-name>Unbound</span></p>
    <button class="field__pause" type="button" aria-pressed="false" data-pause hidden>Pause motion</button>
  </div>
</div>

<script>
  import { startField } from '../scripts/field/field';

  const root = document.querySelector<HTMLElement>('[data-field]');
  if (root) {
    // After first paint, when the browser is idle. Nothing waits for the field.
    const start = () => startField(root);
    requestAnimationFrame(() =>
      'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 300),
    );
  }
</script>
