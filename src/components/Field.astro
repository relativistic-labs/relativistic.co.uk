---
import { fontData } from 'astro:assets';

// The background field: decorative, and an enhancement. Without JavaScript or WebGL2 it isn't shown.
// It is a button so the animation can be paused from a pointer or the keyboard (WCAG 2.2.2).
// The worker samples the typed line with the page's Commit Mono subset.
const mono = fontData['--font-commit']?.[0]?.src[0]?.url;
---

<button class="field" type="button" data-field data-mono={mono} aria-pressed="false" aria-label="Pause background animation">
  <canvas class="field__canvas"></canvas>
</button>

<script>
  import { startField } from '../scripts/field/field';

  const root = document.querySelector<HTMLButtonElement>('[data-field]');
  if (root) {
    // After first paint, when the browser is idle. Nothing waits for the field.
    const start = () => void startField(root);
    requestAnimationFrame(() =>
      'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 300),
    );
  }
</script>
