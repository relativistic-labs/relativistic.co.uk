---
import Section from './Section.astro';
import Services from './Services.astro';
import { howWeWork } from '../content/copy';
---

<Section id="how-we-work" question={howWeWork.question} heading={howWeWork.heading}>
  <dl class="steps">
    {
      howWeWork.steps.map((s) => (
        <div>
          <dt>{s.term}</dt>
          <dd>{s.text}</dd>
        </div>
      ))
    }
  </dl>
  <p class="product">{howWeWork.product}</p>
  <Services />
</Section>
