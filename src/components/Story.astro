---
import SectionLabel from './SectionLabel.astro';
import { story } from '../content/copy';
import { sectionNumber } from '../site.config';
---

<section id="story" class="section wrap" aria-labelledby="story-heading">
  <SectionLabel number={sectionNumber('story')} label="Story" />
  <h2 id="story-heading">{story.heading}</h2>
  <div class="prose">
    {story.paragraphs.map((p) => <p>{p}</p>)}
  </div>
</section>
