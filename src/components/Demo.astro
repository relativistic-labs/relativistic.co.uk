<script>
  import { initDemo } from '../scripts/demo';

  const root = document.querySelector<HTMLElement>('[data-demo]');
  const pause = document.querySelector<HTMLButtonElement>('[data-demo-pause]');
  if (root && pause) initDemo(root, pause);
</script>
