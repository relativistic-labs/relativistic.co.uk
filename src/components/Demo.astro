            <rect class="b a" x="128" y="44" width="44" height="6" rx="3"></rect>
            <text class="b t-xl" x="127" y="92">Introducing</text>
            <text class="b t-xl" x="127" y="122">Lumen</text>
            <rect class="b f b-x" x="128" y="140" width="150" height="7" rx="3.5"></rect>
