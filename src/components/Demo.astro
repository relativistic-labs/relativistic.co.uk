            <rect class="b w" x="12" y="114" width="76" height="43" rx="3"></rect>
            <rect class="b w" x="12" y="165" width="76" height="43" rx="3"></rect>
            <rect class="b w" x="12" y="216" width="76" height="43" rx="3"></rect>
