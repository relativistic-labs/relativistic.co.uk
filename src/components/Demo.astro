            <text class="b t-s t-b" x="262" y="178">Deliveries by week</text>
            <g class="b heat"><rect x="262" y="194" width="13" height="13" rx="2.5" class="h2"></rect><rect x="279" y="194" width="13" height="13" rx="2.5" class="h3"></rect><rect x="296" y="194" width="13" height="13" rx="2.5" class="h1"></rect><rect x="313" y="194" width="13" height="13" rx="2.5" class="h4"></rect><rect x="330" y="194" width="13" height="13" rx="2.5" class="h3"></rect><rect x="347" y="194" width="13" height="13" rx="2.5" class="h2"></rect><rect x="364" y="194" width="13" height="13" rx="2.5" class="h4"></rect><rect x="381" y="194" width="13" height="13" rx="2.5" class="h3"></rect><rect x="398" y="194" width="13" height="13" rx="2.5" class="h4"></rect><rect x="415" y="194" width="13" height="13" rx="2.5" class="h2"></rect><rect x="432" y="194" width="13" height="13" rx="2.5" class="h3"></rect></g>
