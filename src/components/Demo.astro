---
import Section from './Section.astro';
import { demo } from '../content/copy';

// A low-fidelity sketch of the workspace: the conversation on the left, the work on the right. With
// JavaScript and motion allowed, scripts/demo.ts types each request and builds its result, element by
// element, in document order (.b; .b-l lines draw, .b-y grows up, .b-x grows across). Without it, or
// with reduced motion, it shows the first request and its result, finished. The sketch is decorative:
// the caption says what it shows.
const [first] = demo.scenes;
---

<Section id="demo" question={demo.question} heading={demo.heading}>
  <figure class="demo" data-demo data-scenes={JSON.stringify(demo.scenes)}>
    <div class="demo__window" aria-hidden="true">
      <div class="demo__bar">
        <svg class="demo__logo" viewBox="0 0 24 24"><path d="M12 2.5 20.5 7.25v9.5L12 21.5 3.5 16.75v-9.5Z"></path></svg>
        <span class="demo__project">/ {demo.project}</span>
        <span class="demo__icons"><i></i><i></i><i></i><b>H</b></span>
      </div>
      <div class="demo__chat">
        <div class="demo__head"><span>‹</span><i></i></div>
        <div class="demo__thread">
          <p class="demo__ask">{first.ask}</p>
          <p class="demo__thinking"><i></i><i></i><i></i></p>
          <p class="demo__reply">{first.reply}</p>
        </div>
        <div class="demo__input">
          <p class="demo__typed" data-placeholder="Ask a follow-up…"></p>
          <div class="demo__controls"><span>+</span><i></i><b>↑</b></div>
        </div>
      </div>
      <div class="demo__panel">
        <div class="demo__tabs">
          <span class="demo__title">{first.title}</span>
          <span class="demo__modes"><b>Preview</b><span>Code</span><span>Connections</span></span>
        </div>
