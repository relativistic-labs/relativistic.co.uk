---
import Field from './Field.astro';
import { opening } from '../content/copy';
---

<section class="opening wrap" aria-labelledby="opening-heading">
  <div class="opening__text">
    <h1 id="opening-heading">{opening.headline}</h1>
    <p class="opening__lede">{opening.lede}</p>
    <p class="opening__action">
      <a class="button" href="#contact"
        >{opening.action}
        <svg width="17" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false"><path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z"></path></svg></a
      >
    </p>
  </div>
  <Field />
</section>
