---
import Section from './Section.astro';
import { models as copy } from '../content/copy';
import { getProviders } from '../lib/content';

// Provider names are technical content, so they are set in mono.
const providers = await getProviders();
---

<Section id="models" question={copy.question} heading={copy.heading}>
  <p class="measure">
    {copy.before}{' '}
    {
      providers.map((p, i) => (
        <>
          <span class="tech">{p}</span>
          {i < providers.length - 2 ? ', ' : i === providers.length - 2 ? ' or ' : ''}
        </>
      ))
    }. {copy.after}
  </p>
</Section>
