---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title={`Page not found · ${site.name}`} description="This page doesn’t exist." path="/404/">
  <article class="page wrap prose">
    <h1>Page not found</h1>
    <p>Nothing here. The page may have moved, or the address may be mistyped.</p>
    <p><a class="button" href="/">Go to the home page</a></p>
  </article>
</Base>
