---
import { Font, fontData } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { REVIEW_BUILD } from 'astro:env/server';
import { site } from '../site.config';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /** Path of this page, for the canonical URL. */
  path: string;
  /** JSON-LD for this page, if any. */
  jsonLd?: object;
  /** Advertise the Markdown version of the page. */
  markdownAlternate?: boolean;
}

const { title, description, path, jsonLd, markdownAlternate = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
// Preload only the headline subset (the first variant in astro.config.ts), not the full fallback face.
const headline = fontData['--font-instrument']?.[0]?.src[0]?.url;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {REVIEW_BUILD && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)" />
    <Font cssVariable="--font-instrument" />
    {headline && <link rel="preload" href={headline} as="font" type="font/woff2" crossorigin />}
    <Font cssVariable="--font-commit" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {markdownAlternate && <link rel="alternate" type="text/markdown" href="/index.md" title="This page in Markdown" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Relativistic wordmark beside a light cone of particles." />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
