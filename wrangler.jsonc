// Production: Workers static assets, no Worker script. Build with `pnpm build:cloudflare` first,
// which writes dist/_headers. Deploys to the Relativistic account, which holds the zone.
// The custom domain lives here until Terraform owns it; then remove `routes` so the two don't fight.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relativistic-site",
  "account_id": "acceb873d28d2928b0d4941a52951072",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "relativistic.co.uk", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
