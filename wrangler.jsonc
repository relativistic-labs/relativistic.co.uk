// Production: Workers static assets, no Worker script. Build with `pnpm build:cloudflare` first,
// which writes dist/_headers. Not deployed yet: the custom domain comes with the DNS move.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relativistic-site",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false
}
