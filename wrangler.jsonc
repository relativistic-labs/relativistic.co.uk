// Production: Workers static assets, no Worker script. Build with `pnpm build:cloudflare` first,
// which writes dist/_headers. Deploys to the Relativistic account, which holds the zone.
// No `routes`: the custom domain relativistic.co.uk belongs to ../infra (OpenTofu), so wrangler only
// uploads versions and the deploy token needs no zone access. Expect a "no deploy targets" warning.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relativistic-site",
  "account_id": "acceb873d28d2928b0d4941a52951072",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false
}
