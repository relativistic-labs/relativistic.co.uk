// Production: Workers static assets, with a small Worker (worker/index.ts) for the interest form.
// Build with `pnpm build:cloudflare` first, which writes dist/_headers. Deploys to the Relativistic account, which holds the zone.
// No `routes`: the custom domain relativistic.co.uk belongs to ../infra (OpenTofu), so wrangler only
// uploads versions and the deploy token needs no zone access. Expect a "no deploy targets" warning.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relativistic-site",
  "account_id": "acceb873d28d2928b0d4941a52951072",
  "compatibility_date": "2026-10-28",
  // Runs only for what isn't a file: the interest form's POST /interest, and would-be 404s.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // A browser's own form post is a navigation, which the assets layer would otherwise answer
    // first, with 405 Method Not Allowed.
    "run_worker_first": ["/interest"]
  },
  // The interest form goes to the team through relativistic-mail, which holds the team list
  // (infra repository, email-worker/). Deploy that first if its Team entrypoint changes.
  "services": [{ "binding": "MAIL", "service": "relativistic-mail", "entrypoint": "Team" }],
  // Five sends a minute per visitor address. The namespace is per account: keep it unique.
  "ratelimits": [{ "name": "INTEREST_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "workers_dev": false,
  "preview_urls": false
}
